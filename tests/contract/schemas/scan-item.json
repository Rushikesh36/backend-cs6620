{
  "$id": "scan-item.json",
  "title": "One scan: GET /scans/{jobId} and every item of the scan lists",
  "type": "object",
  "required": [
    "jobId",
    "projectId",
    "scanType",
    "targetId",
    "status",
    "requestedBy",
    "imageTag",
    "createdAt",
    "queuedAt",
    "startedAt",
    "finishedAt",
    "summary",
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "jobId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "projectId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,49}$" },
    "scanType": { "enum": ["SAST", "DAST"] },
    "targetId": { "type": ["string", "null"] },
    "status": { "enum": ["CREATED", "QUEUED", "RUNNING", "COMPLETED", "FAILED"] },
    "requestedBy": { "type": "string", "minLength": 1 },
    "imageTag": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "queuedAt": { "type": ["string", "null"], "format": "date-time" },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "finishedAt": { "type": ["string", "null"], "format": "date-time" },
    "summary": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["new", "newHigh", "stillOpen", "fixed"],
          "additionalProperties": false,
          "properties": {
            "new": { "type": "integer", "minimum": 0 },
            "newHigh": { "type": "integer", "minimum": 0 },
            "stillOpen": { "type": "integer", "minimum": 0 },
            "fixed": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "error": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "$comment": "summary is null until COMPLETED",
      "if": { "properties": { "status": { "const": "COMPLETED" } }, "required": ["status"] },
      "then": { "properties": { "summary": { "type": "object" } } },
      "else": { "properties": { "summary": { "type": "null" } } }
    },
    {
      "$comment": "A FAILED scan uses exactly one of the contract's failure messages",
      "if": { "properties": { "status": { "const": "FAILED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "error": {
            "type": "string",
            "pattern": "^(Scanner exited with code [0-9]+|No report produced|Timed out after 25 minutes|Could not start scanner task)$"
          }
        }
      }
    }
  ]
}
