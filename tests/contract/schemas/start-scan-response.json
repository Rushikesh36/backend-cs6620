{
  "$id": "start-scan-response.json",
  "title": "POST /scans/{jobId}/start 200",
  "type": "object",
  "required": ["jobId", "status"],
  "additionalProperties": false,
  "properties": {
    "jobId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "status": { "const": "QUEUED" }
  }
}
