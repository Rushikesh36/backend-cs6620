# Pinned versions for the scanner images (Task 21). scripts/build_scanner_images.sh reads this
# file. Change a version here, bump IMAGE_REVISION, rebuild, and put the new tags in tfvars.
NODE_VERSION=22.21.1
SEMGREP_VERSION=1.183.0
ZAP_VERSION=2.17.0
# Our own changes (wrapper code, rule packs) to an image with the same scanner version.
IMAGE_REVISION=1
# Semgrep registry rule packs baked into the image, so scans run offline.
SEMGREP_RULE_PACKS="default python javascript secrets"
