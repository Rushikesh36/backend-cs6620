{
  "name": "cs6620-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Unified Security Hub backend (CS6620, Team 6)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "add-user": "tsx scripts/add_user.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@eslint/js": "^9.15.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.10.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-security": "^3.0.1",
    "prettier": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.17.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3"
  }
}
